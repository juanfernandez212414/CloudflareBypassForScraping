# Salin ke .env lalu sesuaikan: cp .env.example .env && chmod 600 .env
MA_YEAR=2025
DOWNLOAD_DIR=/mnt/data_1_5TB/putusan_2025
# Default DB ada di DOWNLOAD_DIR. Di WSL dengan drive Windows (/mnt/c, /mnt/d),
# taruh DB di filesystem Linux agar SQLite aman & cepat, mis.:
# DB_NAME=/home/USER/ma/bot_state.db
BYPASS_URL=http://localhost:8000

# Kecepatan. REQ_PER_SEC = batas total request ke situs MA (crawl + unduh).
# Tiap putusan = 2 request: 4 req/detik ~ 2 putusan/detik ~ 170 rb/hari
# -> 978 rb putusan (2025) ±5,8 hari.
REQ_PER_SEC=4
# Koneksi bersamaan. Situs MA lambat (uji awal ±20 dtk/request), jadi perlu
# banyak koneksi agar REQ_PER_SEC tercapai: kira-kira REQ_PER_SEC x detik/request.
# Laporan (baris "Saran") menghitung angka yang dibutuhkan dari respons nyata.
WORKERS=24
CRAWL_WORKERS=6
MAX_ATTEMPTS=5
# Unduhan dijeda otomatis bila sisa disk di bawah angka ini (GB)
MIN_FREE_GB=5

# Laporan: target dihitung sejak bot pertama kali jalan
TARGET_DAYS=7
# REPORT_FILE=/mnt/data_1_5TB/putusan_2025/laporan.log
REPORT_EVERY_MIN=60
